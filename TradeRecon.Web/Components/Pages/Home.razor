@page "/"
@rendermode InteractiveServer
@using System.Net.Http.Json
@using TradeRecon.Core.DTOs
@using TradeRecon.Core.Models
@using TradeRecon.Core.Enums
@inject IHttpClientFactory HttpClientFactory

<PageTitle>TradeRecon Dashboard</PageTitle>

<div class="container-fluid px-4 py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold mb-1">TradeRecon</h1>
            <p class="text-muted mb-0">
                Financial Reconciliation & Data Governance Platform
            </p>
        </div>

        <button class="btn btn-primary btn-lg"
                disabled="@isRunning"
                @onclick="RunReconciliation">
            @(isRunning ? "Running..." : "Run Reconciliation")
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="alert alert-info">
            @message
        </div>
    }

    <div class="row g-3 mb-4">

        <div class="col-md">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="text-muted">Total Results</div>
                    <div class="display-6 fw-bold">@summary.Total</div>
                </div>
            </div>
        </div>

        <div class="col-md">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="text-muted">Matched</div>
                    <div class="display-6 fw-bold text-success">
                        @summary.Matched
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="text-muted">Mismatched</div>
                    <div class="display-6 fw-bold text-danger">
                        @summary.Mismatched
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="text-muted">Missing</div>
                    <div class="display-6 fw-bold text-warning">
                        @summary.Missing
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="text-muted">Match Rate</div>
                    <div class="display-6 fw-bold">
                        @summary.MatchRate.ToString("0.00")%
                    </div>
                </div>
            </div>
        </div>

    </div>

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header bg-white py-3">
            <h4 class="mb-0">Reconciliation Results</h4>
        </div>

        <div class="card-body p-0">

            @if (results.Count == 0)
            {
                <div class="p-4 text-muted">
                    No reconciliation results available.
                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover mb-0">

                        <thead class="table-light">
                            <tr>
                                <th>Trade ID</th>
                                <th>Status</th>
                                <th>Message</th>
                                <th>Reconciled At</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var result in results)
                            {
                                <tr>
                                    <td class="fw-semibold">
                                        @result.TradeId
                                    </td>

                                    <td>
                                        <span class="@GetStatusClass(result.Status)">
                                            @result.Status
                                        </span>
                                    </td>

                                    <td>
                                        @result.Message
                                    </td>

                                    <td>
                                        @(result.ReconciledAt.ToLocalTime().ToString("g"))
                                    </td>
                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>
    </div>

    <div class="card shadow-sm border-0">

        <div class="card-header bg-white py-3">
            <h4 class="mb-0">Recent Audit Activity</h4>
        </div>

        <div class="card-body p-0">

            @if (auditLogs.Count == 0)
            {
                <div class="p-4 text-muted">
                    No audit activity recorded yet.
                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover mb-0">

                        <thead class="table-light">
                            <tr>
                                <th>Action</th>
                                <th>Entity</th>
                                <th>Details</th>
                                <th>User</th>
                                <th>Timestamp</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var log in auditLogs.Take(10))
                            {
                                <tr>
                                    <td class="fw-semibold">
                                        @log.Action
                                    </td>

                                    <td>@log.EntityType</td>

                                    <td>@log.Details</td>

                                    <td>@log.UserName</td>

                                    <td>
                                        @(log.CreatedAt.ToLocalTime().ToString("g"))
                                    </td>
                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>
    </div>

</div>

@code {

    private ReconciliationSummaryDto summary = new();

    private List<ReconciliationResult> results = new();

    private List<AuditLog> auditLogs = new();

    private string message = string.Empty;

    private bool isRunning;

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboard();
    }

    private async Task LoadDashboard()
    {
        try
        {
            var client =
                HttpClientFactory.CreateClient(
                    "TradeReconApi");

            summary =
                await client.GetFromJsonAsync<ReconciliationSummaryDto>(
                    "api/dashboard/summary")
                ?? new();

            results =
                await client.GetFromJsonAsync<List<ReconciliationResult>>(
                    "api/reconciliation")
                ?? new();

            auditLogs =
                await client.GetFromJsonAsync<List<AuditLog>>(
                    "api/audit")
                ?? new();
        }
        catch
        {
            message =
                "Unable to connect to the TradeRecon API.";
        }
    }

    private async Task RunReconciliation()
    {
        try
        {
            isRunning = true;
            message = string.Empty;

            var client =
                HttpClientFactory.CreateClient(
                    "TradeReconApi");

            var response =
                await client.PostAsync(
                    "api/reconciliation/run",
                    null);

            if (response.IsSuccessStatusCode)
            {
                message =
                    "Reconciliation completed successfully.";

                await LoadDashboard();
            }
            else
            {
                message =
                    "Reconciliation failed.";
            }
        }
        catch
        {
            message =
                "Unable to connect to the TradeRecon API.";
        }
        finally
        {
            isRunning = false;
        }
    }

    private static string GetStatusClass(
        ReconciliationStatus status)
    {
        return status switch
        {
            ReconciliationStatus.Matched =>
                "badge bg-success",

            ReconciliationStatus.QuantityMismatch =>
                "badge bg-danger",

            ReconciliationStatus.PriceMismatch =>
                "badge bg-danger",

            ReconciliationStatus.MissingFromBroker =>
                "badge bg-warning text-dark",

            ReconciliationStatus.MissingFromInternal =>
                "badge bg-warning text-dark",

            ReconciliationStatus.Duplicate =>
                "badge bg-secondary",

            ReconciliationStatus.Invalid =>
                "badge bg-dark",

            _ =>
                "badge bg-secondary"
        };
    }
}

